# Every rule here names a specific path and says what puts the file back.
# Nothing is ignored by bare extension or by blanket directory: a rule that
# swallows hand-written work is invisible, because the file simply is not there
# to notice.

# --- build output -----------------------------------------------------------
# Regenerated by: gradlew build
/build/
/.gradle/

# --- your private key -------------------------------------------------------
# Generated by: rs3os run-tool rsa-key-generator
# This is the RSA private key your patched client trusts. It must never be
# published. Anyone with it can impersonate your server to your client.
/data/config/rsa.toml

# --- your deployment's configuration ----------------------------------------
# Copy the .example files beside them and edit. They are per-deployment, not
# project source.
/data/config/server.toml
/data/config/mods.json
/data/config/proxy.toml

# --- the game cache ---------------------------------------------------------
# Downloaded by: rs3os run-tool cache-downloader   (tens of gigabytes)
/data/cache/

# --- data derived from your cache -------------------------------------------
# Decoded from Jagex's cache, so not ours to redistribute. Both are rebuilt
# during setup from the copy of the cache you downloaded.
#   rs3os run-tool db-builder --output data/rs3.sqlite
#   python3 tools/seed/seed_from_cache.py
/data/rs3.sqlite
/data/rs3.built.sqlite
/data/seed/npc_cache.json

# --- player accounts --------------------------------------------------------
# Created by the server on first login. Contains your players' data.
/data/accounts.sqlite
/data/accounts.sqlite-shm
/data/accounts.sqlite-wal

# --- client binaries --------------------------------------------------------
# You supply the original; the patched copy is written by
# rs3os run-tool client-patcher. Jagex's binaries are not ours to redistribute.
/data/clients/
/data/launchers/

# --- runtime output ---------------------------------------------------------
# Written by the running server.
/logs/
/data/diag/
/data/proxy/
/data/resources/

# --- editors and OS ---------------------------------------------------------
/.idea/
*.iml
.DS_Store
Thumbs.db
